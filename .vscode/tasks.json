{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ВСЁ: поднять",
      "type": "shell",
      "command": "make up"
    },
    {
      "label": "ВСЁ: погасить",
      "type": "shell",
      "command": "make down"
    },
    {
      "label": "ВСЁ: логи",
      "type": "shell",
      "command": "make logs"
    },
    {
      "label": "db: поднять Postgres",
      "type": "shell",
      "command": "make db"
    },
    {
      "label": "db: погасить Postgres",
      "type": "shell",
      "command": "make db-stop"
    },
    {
      "label": "api: миграции",
      "type": "shell",
      "command": "make migrate"
    },
    {
      "label": "api: запустить",
      "type": "shell",
      "command": "make api"
    },
    {
      "label": "worker: таблица задач",
      "type": "shell",
      "command": "make worker-init"
    },
    {
      "label": "worker: запустить",
      "type": "shell",
      "command": "make worker"
    },
    {
      "label": "mobile: запустить",
      "type": "shell",
      "command": "make mobile"
    },
    {
      "label": "тесты: все",
      "type": "shell",
      "command": "make test",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "тесты: api",
      "type": "shell",
      "command": "make test-api",
      "group": "test"
    },
    {
      "label": "тесты: mobile",
      "type": "shell",
      "command": "make test-mobile",
      "group": "test"
    },
    {
      "label": "тесты: worker",
      "type": "shell",
      "command": "make test-montage",
      "group": "test"
    },
    {
      "label": "линт и типы",
      "type": "shell",
      "command": "make check",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "поставить зависимости",
      "type": "shell",
      "command": "make install"
    }
  ],
  "presentation": {
    "panel": "dedicated",
    "clear": true
  },
  "options": {
    "cwd": "${workspaceFolder}"
  }
}
